class Solution {
public:
    bool isAdditiveNumber(string num) {
        int n = num.length();
        for (int i = 0; i < n / 2; ++i) {
            if (num[0] == '0' && i > 0) break;
            
            string s1 = num.substr(0, i + 1);
            for (int j = i + 1; n - 1 - j >= max(i + 1, j - i); ++j) {
                if (num[i + 1] == '0' && j > i + 1) break;
                
                string s2 = num.substr(i + 1, j - i);
               if (isValid(s1, s2, j + 1, num)) {
                    return true;
                }
            }
        }
        return false;
    }

private:
    string addStrings(string num1, string num2) {
        string result = "";
        int i = num1.length() - 1;
        int j = num2.length() - 1;
        int carry = 0;
        
        while (i >= 0 || j >= 0 || carry) {
            int sum = carry;
            if (i >= 0) sum += num1[i--] - '0';
            if (j >= 0) sum += num2[j--] - '0';
            
            carry = sum / 10;
            result += to_string(sum % 10);
        }
        
        reverse(result.begin(), result.end());
        return result;
    }
 bool isValid(string s1, string s2, int k, const string& num) {
        while (k < num.length()) {
            string s3 = addStrings(s1, s2);
            if (num.compare(k, s3.length(), s3) != 0) {
                return false;
            }
            k += s3.length();
            s1 = s2;
            s2 = s3;
        }
        return true;
    }
};
