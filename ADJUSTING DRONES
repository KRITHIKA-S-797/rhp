#include <iostream>
#include <vector>
#include <map>
#include <algorithm>

using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;

    map<int, int> mp;
    for (int i = 0; i < n; i++) {
        int x;
        cin >> x;
        mp[x]++;
    }

    vector<int> duplicates;
    vector<int> unique_elements;

    for (auto it = mp.rbegin(); it != mp.rend(); ++it) {
        int x = it->first;
        int count = it->second;
        
        unique_elements.push_back(x);
        
        for (int i = 0; i < count - 1; i++) {
            duplicates.push_back(x);
        }
    }

    reverse(unique_elements.begin(), unique_elements.end());

    vector<int> empty_slots;
    int unique_idx = 0;
    int max_needed_slots = n + 5; 
    
    for (int i = 0; empty_slots.size() < max_needed_slots; i++) {
        if (unique_idx < unique_elements.size() && unique_elements[unique_idx] == i) {
            unique_idx++;
        } else {
            empty_slots.push_back(i);
        }
    }

    int ans = 0;
    int slot_idx = 0;

    for (int x : duplicates) {
        while (slot_idx < empty_slots.size() && empty_slots[slot_idx] < x) {
            slot_idx++;
        }

        if (slot_idx < empty_slots.size()) {
            if (k > 0) {
                ans = max(ans, empty_slots[slot_idx] - x);
                k--;
            }
            slot_idx++;
        }
    }

    cout << ans << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
