#include<iostream>
#include<algorithm>
using namespace std;
int hcf(int a,int b){
    return b==0 ? a : hcf(b, a % b);
}
int main(){
    int tc;
    cin>>tc;
    while(tc>0){
        int n;
        cin>>n;
        int arr[n];
        for(int i=0;i<n;i++){
            cin>>arr[i];
        }
        int a=arr[0];
        int b=arr[n-1];
        cout<<hcf(a,b)<<endl;
    }
}
